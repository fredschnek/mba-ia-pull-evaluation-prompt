# LangSmith Configuration
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
# LANGSMITH_PROJECT controla o nome do projeto de tracing (runs aparecem aqui)
LANGSMITH_PROJECT=
# LANGCHAIN_PROJECT controla o nome do dataset de avaliação (lido por src/evaluate.py).
# Se vazio, o evaluate.py usa o default "prompt-optimization-challenge-resolved"
# e cria o dataset "{LANGCHAIN_PROJECT}-eval". Defina para customizar.
LANGCHAIN_PROJECT=

# Publique um prompt no langsmith hub para gerar seu username, depois abra o prompt e vá no simbolo de cadeado.
USERNAME_LANGSMITH_HUB=

# OpenAI Configuration
OPENAI_API_KEY=

# Google Gemini Configuration
GOOGLE_API_KEY=

# LLM Configuration
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash
EVAL_MODEL=gemini-2.5-flash

# Mixed-provider opcional: avaliar com OpenAI mesmo gerando com Gemini.
# Se EVAL_PROVIDER estiver definido, src/utils.py:get_eval_llm() o usa em vez de LLM_PROVIDER.
#EVAL_PROVIDER=openai

#LLM_PROVIDER=openai
#LLM_MODEL=gpt-4o-mini
#EVAL_MODEL=gpt-4o